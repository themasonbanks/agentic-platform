{
  "title": "Personal engineering task contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issue",
    "repository",
    "branch",
    "worktree",
    "intent",
    "criteria",
    "paths",
    "tools",
    "checks",
    "human_gates",
    "limits",
    "terminal_outcomes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[A-Z][A-Z0-9]{1,15}-[1-9][0-9]*$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "edit",
          "check",
          "draft_pr"
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "human_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "runtime_seconds",
        "cost_microusd"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "verified",
          "blocked",
          "cancelled",
          "failed"
        ]
      }
    }
  }
}
