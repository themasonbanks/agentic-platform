{
  "id": null,
  "uid": "agentic-engineering-draft",
  "title": "Agentic engineering \u2014 draft",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "agentic",
    "draft"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Run success (%)",
      "description": "Completed successful runs / completed success-or-failure runs; queued/cancelled runs excluded. Producer contract only; live ingestion must be verified.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(agentic_runs_total{repository=~\"${repository}\",outcome=\"success\"}[$__range])) / sum(increase(agentic_runs_total{repository=~\"${repository}\",outcome=~\"success|failure\"}[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CI first-pass success (%)",
      "description": "First completed attempt per workflow run; skipped/neutral/cancelled excluded, missing denominator unknown. Producer contract only; live ingestion must be verified.",
