        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(agentic_ci_attempts_total{repository=~\"${repository}\",attempt=\"1\",outcome=\"success\"}[$__range])) / sum(increase(agentic_ci_attempts_total{repository=~\"${repository}\",attempt=\"1\",outcome=~\"success|failure\"}[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown"
                }
              }
            }
          ]
        },
        "overrides": []
