  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "repository",
        "label": "Project repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": "label_values(agentic_metric_source_events_total, repository)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  }
}
